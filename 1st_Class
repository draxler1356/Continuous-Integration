<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My GitHub Project</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #222;
            background: #f5f7fa;
        }

        /* Navigation */
        nav {
            background: #24292f;
            color: white;
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        nav h2 {
            font-size: 24px;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 25px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
        }

        nav ul li a:hover {
            color: #58a6ff;
        }

        /* Hero */
        .hero {
            min-height: 70vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 40px 20px;
            background: linear-gradient(135deg, #24292f, #0969da);
            color: white;
        }

        .hero h1 {
            font-size: 50px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            background: white;
            color: #0969da;
            padding: 12px 25px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover {
            background: #e6edf3;
        }

        /* Features */
        .features {
            padding: 60px 8%;
            text-align: center;
        }

        .features h2 {
            margin-bottom: 30px;
            font-size: 32px;
        }

        .cards {
            display: flex;
            justify-content: center;
            gap: 25px;
            flex-wrap: wrap;
        }

        .card {
            background: white;
            width: 280px;
            padding: 30px 20px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .card h3 {
            margin-bottom: 10px;
            color: #0969da;
        }

        /* Footer */
        footer {
            background: #24292f;
            color: white;
            text-align: center;
            padding: 20px;
        }

        /* Mobile */
        @media (max-width: 600px) {
            nav {
                flex-direction: column;
                gap: 10px;
            }

            nav ul {
                gap: 15px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .hero p {
                font-size: 17px;
            }
        }
    </style>
</head>

<body>

    <nav>
        <h2>MyProject</h2>

        <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#about">About</a></li>
        </ul>
    </nav>

    <section class="hero" id="home">
        <div>
            <h1>Welcome to My Project</h1>
            <p>A simple and beautiful website hosted with GitHub Pages.</p>

            <a href="https://github.com/" class="btn">
                View on GitHub
            </a>
        </div>
    </section>

    <section class="features" id="features">
        <h2>Features</h2>

        <div class="cards">

            <div class="card">
                <h3>🚀 Fast</h3>
                <p>
                    Lightweight HTML and CSS for a fast-loading website.
                </p>
            </div>

            <div class="card">
                <h3>📱 Responsive</h3>
                <p>
                    Works smoothly on desktops, tablets, and mobile devices.
                </p>
            </div>

            <div class="card">
                <h3>💻 Open Source</h3>
                <p>
                    Easily customize and share your project through GitHub.
                </p>
            </div>

        </div>
    </section>

    <section class="features" id="about">
        <h2>About</h2>

        <p>
            This is a simple starter website created using HTML and CSS.
            You can customize it for your portfolio, college project,
            personal website, or GitHub Pages project.
        </p>
    </section>

    <footer>
        <p>&copy; 2026 MyProject. All rights reserved.</p>
    </footer>

</body>
</html>
